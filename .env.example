# === Bot Discord MTBR ===
# Copie ce fichier en ".env" et remplis les valeurs.

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID de ton serveur Discord (mode développeur activé > clic droit sur le serveur > Copier l'identifiant)
# Sert à déployer les commandes instantanément sur ton serveur pendant le développement.
GUILD_ID=

# (Optionnel) ID d'un salon où le bot enverra ses logs / annonces de reset hebdo
LOG_CHANNEL_ID=

# (Optionnel) Mets "true" pour activer le bonus d'XP "pub le serveur dans le statut".
# Nécessite aussi d'activer PRESENCE INTENT dans le Developer Portal (onglet Bot).
ENABLE_PRESENCE_INTENT=false
